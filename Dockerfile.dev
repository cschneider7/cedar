# Frontend dev image: installs dependencies at build time (cached layer);
# application source is bind-mounted at runtime by docker-compose.yaml for
# hot module reload. Not used for production — see Dockerfile.
FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
