# Backend dev image: installs system deps + dev tooling (cargo-watch,
# sqlx-cli) and pre-fetches crates.io dependencies at build time (cached
# layer). Application source is bind-mounted at runtime by
# docker-compose.yaml for hot reload via cargo-watch. Not used for
# production — see class_management/Dockerfile.
#
# Build context is the repo root (same as class_management/Dockerfile), so
# the workspace Cargo.toml/Cargo.lock are visible.
FROM rust:1-slim-trixie

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*

# cargo-watch drives the reload loop; sqlx-cli runs migrations on startup
# and is also what `cargo sqlx prepare` (the pre-commit hook) needs.
RUN cargo install cargo-watch \
    && cargo install sqlx-cli --version 0.9.0 --no-default-features --features postgres,native-tls

# Pre-fetch dependencies into the image so the cargo registry/git named
# volumes start warm instead of empty. Real source arrives via bind mount
# at container start, so a throwaway src/main.rs is enough here.
COPY Cargo.toml Cargo.lock ./
COPY class_management/Cargo.toml class_management/Cargo.toml
RUN mkdir -p class_management/src \
    && echo "fn main() {}" > class_management/src/main.rs \
    && cargo fetch --locked

COPY class_management/docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.dev.sh

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.dev.sh"]
