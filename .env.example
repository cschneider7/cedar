# Copy to .env and fill in real values for local dev.

# Frontend
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
VITE_API_URL=http://localhost:3000/api/v1

# Backend
RUST_LOG=class_management=debug,tower_http=debug
FRONTEND_ORIGIN=http://localhost:5173

# Neon database and auth credentials
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth

# Test account for development
NEON_AUTH_TEST_EMAIL=
NEON_AUTH_TEST_PASSWORD=

# S3 credentials
S3_BUCKET=bucket-name
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
