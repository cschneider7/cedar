# Copy to .env and fill in real values for local dev.

# --- Postgres (used by docker-compose: initializes the local container,
# and its DATABASE_URL is constructed from these for the `backend` service) ---
POSTGRES_DB=seating_chart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
RUST_LOG=class_management=debug,tower_http=debug
FRONTEND_ORIGIN=http://localhost:5173
CLERK_SECRET_KEY=sk_test_...
# `docker compose up` overrides this for the `backend` service (points at
# the postgres service instead) — this value is only used if you run the
# backend directly on the host, e.g. against a Neon branch instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seating_chart
# Only needed if DATABASE_URL points at Neon: sqlx's compile-time query
# macros require the *unpooled* connection string, not the `-pooler` one —
# `neon connection-string <branch> --pooled=false` prints it. Irrelevant
# for the docker-compose Postgres container above.
DATABASE_URL_UNPOOLED=
# The Neon branch this local `DATABASE_URL` targets, if using Neon instead
# of the docker-compose Postgres container — matches the `.neon` file's
# linked project's branch (see CLAUDE.md).
NEON_BRANCH=dev

# --- Frontend ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_URL=http://localhost:3000/api/v1

# --- E2E tests (tests/e2e/, `npm run test:e2e`) ---
# A real test-mode Clerk user's credentials. Only needed to run the
# sign-in/sign-out test; the unauthenticated-redirect test always runs.
CLERK_TEST_EMAIL=
CLERK_TEST_PASSWORD=
