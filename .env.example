# Copy to .env and fill in real values for local dev.

# --- docker-compose Postgres only (unused once DATABASE_URL points at Neon) ---
POSTGRES_DB=seating_chart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
RUST_LOG=class_management=debug,tower_http=debug
FRONTEND_ORIGIN=http://localhost:5173
CLERK_SECRET_KEY=sk_test_...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seating_chart
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/seating_chart
NEON_BRANCH=dev

# --- Frontend ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_URL=http://localhost:3000/api/v1
