# Copy to .env and fill in real values for local dev.

# --- Postgres (used by docker-compose: initializes the local container,
# and its DATABASE_URL is constructed from these for the `backend` service) ---
POSTGRES_DB=cedar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
RUST_LOG=class_management=debug,tower_http=debug
FRONTEND_ORIGIN=http://localhost:5173
# Neon Auth base URL — JWKS is derived as <NEON_AUTH_URL>/.well-known/jwks.json
NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cedar
DATABASE_URL_UNPOOLED=
NEON_BRANCH=dev
# S3-compatible object storage: MinIO locally, Cloudflare R2 in Preview/Production
S3_BUCKET=cedar-dev
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Feeds the docker-compose `minio` service directly — must match
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Frontend ---
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
VITE_API_URL=http://localhost:3000/api/v1

# --- E2E tests (tests/e2e/, `npm run test:e2e`) ---
NEON_AUTH_TEST_EMAIL=
NEON_AUTH_TEST_PASSWORD=
