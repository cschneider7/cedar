# Copy to .env and fill in real values for local dev.

# Frontend
VITE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
VITE_PUBLIC_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001/api/v1

# Backend
RUST_LOG=class_management=debug,tower_http=debug
FRONTEND_ORIGIN=http://localhost:5173

# Local Supabase stack
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_AUTH_BASE_URL=http://127.0.0.1:54321/auth/v1

# Test account for development
SUPABASE_AUTH_TEST_EMAIL=
SUPABASE_AUTH_TEST_PASSWORD=

# S3 credentials
S3_BUCKET=bucket-name
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
