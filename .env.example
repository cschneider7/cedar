# Copy to .env and fill in real values for local dev.

# Frontend
VITE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Backend
RUST_LOG=class_management=debug,tower_http=debug

# Local Supabase stack
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_URL=http://127.0.0.1:54321

# Test account for development / the gated e2e sign-in test
SUPABASE_AUTH_TEST_EMAIL=
SUPABASE_AUTH_TEST_PASSWORD=

# Playwright e2e worker/user pool size (see tests/e2e/prepare-stack.ts).
# Must be >= (playwright workers) + 1 (the last index is the empty-state user).
E2E_USER_POOL_SIZE=6

# S3 credentials
S3_BUCKET=bucket-name
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
