# Copy to .env and fill in real values for local dev.

# --- Postgres (used by docker-compose: initializes the local container,
# and its DATABASE_URL is constructed from these for the `backend` service) ---
POSTGRES_DB=seating_chart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
RUST_LOG=class_management=debug,tower_http=debug
FRONTEND_ORIGIN=http://localhost:5173
CLERK_SECRET_KEY=sk_test_...
# `docker compose up` overrides this for the `backend` service (points at
# the postgres service instead) — this value is only used if you run the
# backend directly on the host, e.g. against a Neon branch instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seating_chart

# --- Frontend ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_URL=http://localhost:3000/api/v1
